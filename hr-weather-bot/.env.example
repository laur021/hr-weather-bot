# --- Telegram ---
# Bot token from @BotFather for @AblazeHRAssistantBot
TELEGRAM_BOT_TOKEN=

# --- Chat IDs (override only if you re-run setup with new groups) ---
AUTHORIZED_HR_CHAT_ID=5368977850
EMPLOYEE_CHAT_ID=5324314507

# --- AI draft generation ---
# deepseek | mock
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: override base URL for any OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# --- Weather source ---
# open-meteo (free, no key) | mock | http | noop
WEATHER_SOURCE=open-meteo

# Open-Meteo location (defaults to Metro Manila)
OPEN_METEO_LATITUDE=14.5995
OPEN_METEO_LONGITUDE=120.9842
OPEN_METEO_LOCATION_NAME=Metro Manila

# For WEATHER_SOURCE=http, the endpoint must return JSON:
# { "severity": "warning", "title": "...", "description": "..." }
# (empty object = no threat)
WEATHER_HTTP_URL=

# Poll interval for http / open-meteo sources
WEATHER_POLL_INTERVAL_MS=600000

# --- Persistence ---
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=info
