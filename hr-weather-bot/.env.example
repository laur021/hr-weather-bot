# --- Telegram ---
# Bot token from @BotFather. A token has the form: 123456789:secret
TELEGRAM_BOT_TOKEN=

# --- Chat IDs (required; Telegram group IDs are negative) ---
AUTHORIZED_HR_CHAT_ID=-5368977850
EMPLOYEE_CHAT_ID=-5324314507

# --- AI draft generation ---
# deepseek | mock
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: override base URL for any OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# DeepSeek Responses API endpoint used only when WEATHER_SOURCE=ai-web.
DEEPSEEK_RESPONSES_BASE_URL=https://api.deepseek.com/responses

# Reserved for a future OpenAI provider. The current bot does not use this key.
OPENAI_API_KEY=

# --- Office and weather sources ---
WEATHER_SOURCE=open-meteo
OFFICE_NAME=Metro Manila
OFFICE_ADDRESS=Metro Manila
OFFICE_LATITUDE=14.5995
OFFICE_LONGITUDE=120.9842
OFFICE_TIMEZONE=Asia/Manila
OFFICE_LOCALITY_MATCHES=NCR,National Capital Region,Metro Manila,Quezon City

# Optional official-source overrides; defaults shown.
PAGASA_BULLETIN_URL=https://www.pagasa.dost.gov.ph/tropical-cyclone/severe-weather-bulletin
PAGASA_DAILY_WEATHER_URL=https://www.pagasa.dost.gov.ph/weather
PAGASA_WEATHER_ADVISORY_URL=https://www.pagasa.dost.gov.ph/weather/weather-advisory

# Interval between automatic Open-Meteo + PAGASA checks.
WEATHER_POLL_INTERVAL_MS=600000

# --- Persistence ---
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=info
