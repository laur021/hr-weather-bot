# --- Telegram ---
# Bot token from @BotFather for @AblazeHRAssistantBot
TELEGRAM_BOT_TOKEN=

# --- Chat IDs (override only if you re-run setup with new groups) ---
AUTHORIZED_HR_CHAT_ID=5368977850
EMPLOYEE_CHAT_ID=5324314507

# --- AI draft generation ---
# deepseek | mock
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: override base URL for any OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# --- Weather source ---
# mock | http | noop
WEATHER_SOURCE=mock
# For WEATHER_SOURCE=http, the endpoint must return JSON:
# { "severity": "warning", "title": "...", "description": "..." }
# (omit/empty object = no threat)
WEATHER_HTTP_URL=
WEATHER_HTTP_INTERVAL_MS=600000

# --- Persistence ---
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=info
