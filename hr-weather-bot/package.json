{
  "name": "hr-weather-bot",
  "version": "0.1.0",
  "description": "HR Weather Advisory System — Telegram bot with group-based authorization, draft workflow, and DeepSeek draft generation.",
  "type": "module",
  "main": "dist/openclaw-runner.js",
  "scripts": {
    "dev": "tsx watch src/openclaw-runner.ts",
    "start": "tsx src/index.ts",
    "openclaw:runner": "npm run build --silent && node dist/openclaw-runner.js",
    "discover": "tsx scripts/discover.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
